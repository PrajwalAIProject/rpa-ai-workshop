# Copy this file to ".env" and fill in your own values.
# The real .env is git-ignored — never commit secrets, never paste them into Copilot Chat.

# ---- Projects 1 and 2 expert: free AI API (see 00-prerequisites/free-ai-api-key.md) ----
# Put the .env in the folder you run ai_stock_report.py from (your project folder),
# or in the repo root when running the reference script.
# Which free AI service to use: gemini (default) or groq
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional backup: free key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the default model (leave commented out normally)
# LLM_MODEL=

# ---- Project 3 expert: the watcher reruns jobs with the UiPath CLI (--act) ----
# Process key from: uip or processes list --folder-path "Shared"   (not a password)
UIPATH_PROCESS_KEY=

# ---- Project 2 expert: optional email (python ai_news_briefing.py --email) ----
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_TO=
