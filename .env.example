# Copy this file to ".env" and fill in your own values.
# The real .env is git-ignored — never commit secrets, never paste them into Copilot Chat.

# ---- Project 1 expert: free AI API (see 00-prerequisites/free-ai-api-key.md) ----
# Put the .env in the folder you run ai_stock_report.py from (your project folder),
# or in the repo root when running the reference script.
# Which free AI service to use: gemini (default) or groq
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional backup: free key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the default model (leave commented out normally)
# LLM_MODEL=

# ---- Project 2 expert: Anthropic Claude (see 00-prerequisites/api-keys.md) ----
ANTHROPIC_API_KEY=

# ---- Project 2 expert: optional SMTP email delivery ----
# Leave SMTP_HOST blank to just print the digest instead of emailing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
