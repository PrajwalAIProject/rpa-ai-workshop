# Copy this file to ".env" and fill in your own values.
# The real .env is git-ignored — never commit secrets.

# ---- LLM provider (Anthropic Claude) ----
# Used by the expert tiers of Project 1 and Project 2.
ANTHROPIC_API_KEY=

# ---- Project 1 expert: optional webhook for posting commentary ----
# Leave blank to just print to the terminal.
WEBHOOK_URL=

# ---- Project 2 expert: optional SMTP email delivery ----
# Leave SMTP_HOST blank to just print the digest instead of emailing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
